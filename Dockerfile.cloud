# 离线/云部署：包内已含 models/ + data/ 向量，构建时不访问 HuggingFace
ARG BASE_IMAGE=python:3.11-slim
FROM ${BASE_IMAGE} AS build

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
# CPU-only torch（避免 CUDA 依赖把镜像撑到 6GB+）
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu \
    && pip install --no-cache-dir -r requirements.txt

ARG BASE_IMAGE
FROM ${BASE_IMAGE}

WORKDIR /app

RUN useradd --create-home --uid 10001 --shell /usr/sbin/nologin push

COPY --from=build /usr/local /usr/local
COPY . .

RUN chmod +x /app/scripts/docker-entrypoint.sh \
    && python -c "\
from server.embedding_model import is_valid_model_dir, DEFAULT_LOCAL_DIR; \
assert is_valid_model_dir(DEFAULT_LOCAL_DIR), \
    f'bundled model missing or invalid: {DEFAULT_LOCAL_DIR}'" \
    && (test -f data/faiss_index.bin || python -m data.generate_data) \
    && mkdir -p /app/data /app/reports /app/config \
    && chown -R push:push /app

EXPOSE 8000

ENTRYPOINT ["/app/scripts/docker-entrypoint.sh"]
CMD ["uvicorn", "server.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4"]
