{
  "enabled": false,
  "schedule": {
    "enabled": false,
    "cron": "0 3 * * *",
    "min_new_samples": 50,
    "cooldown_hours": 24
  },
  "positive_threshold": 0.5,
  "min_positive": 2,
  "max_sim": 0.95,
  "epsilon": 0.02,
  "max_tune_failures": 3,
  "max_versions": 5,
  "source_ratio_cap": 0.7,
  "review": {
    "provider": "none",
    "timeout_sec": 30
  },
  "training": {
    "epochs": 3,
    "batch_size": 32,
    "learning_rate": 2e-5,
    "warmup_ratio": 0.1,
    "max_seq_length": 256
  },
  "eval": {
    "k": 5,
    "freeze_size": 100
  }
}
