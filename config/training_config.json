{
  "enabled": false,
  "schedule": {
    "enabled": false,
    "cron": "0 3 * * *",
    "min_new_samples": 50,
    "cooldown_hours": 24
  },
  "positive_threshold": 0.5,
  "min_positive": 2,
  "max_sim": 0.95,
  "epsilon": 0.02,
  "max_tune_failures": 3,
  "max_versions": 5,
  "source_ratio_cap": 0.7,
  "storage": {
    "backend": "sqlite",
    "dsn_env": "DATABASE_URL",
    "redis_url_env": "REDIS_URL",
    "fallback": "sqlite",
    "sqlite_path": "data/training/training.db"
  },
  "reward": {
    "adapter": "builtin:generic_funnel",
    "window_sec": 86400,
    "unknown_policy": "exclude",
    "events": {
      "click": { "role": "step", "weight": 0.2 },
      "watch_end": { "role": "success", "weight": 1.0, "min_ratio": 0.5 },
      "share": { "role": "success", "weight": 1.0 },
      "favorite": { "role": "success", "weight": 1.0 },
      "no_click": { "role": "failure" },
      "not_interested": { "role": "failure" }
    }
  },
  "scale": {
    "negatives_per_anchor": 8,
    "negative_strategy": "ann",
    "sample_cap": 200000,
    "page_size": 5000,
    "ann": { "index": "Flat", "nprobe": 16 },
    "shards": 8,
    "max_steps": 2000
  },
  "eval": {
    "mode": "push_success",
    "k": 3,
    "catalog_recall": true,
    "propensity": true,
    "freeze_size": 5000
  },
  "training": {
    "loss": "mnrl_weighted",
    "epochs": 3,
    "batch_size": 32,
    "learning_rate": 2e-5,
    "warmup_ratio": 0.1,
    "max_seq_length": 256
  }
}
