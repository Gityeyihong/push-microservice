# === Push Microservice 环境变量 ===
# 复制为 .env 后填写。.env 已被 .gitignore 忽略，切勿提交。

# ---- 服务 ----
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_WORKERS=4

# ---- 安全 ----
# Redis 缓存键 HMAC 盐；生产必须改为强随机值
HMAC_SECRET_KEY=change-me-in-production
# 管理接口 Bearer 令牌（/admin/*）；留空则管理接口返回 503
PUSH_ADMIN_TOKEN=
# 内部接口令牌（/internal/*）；留空回退 PUSH_ADMIN_TOKEN
PUSH_INTERNAL_TOKEN=

# ---- Redis 缓存（不可用时自动降级） ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ---- 向量 ----
# 1=离线随机向量（无需模型）；0=真实语义向量（需本地模型）
PUSH_USE_MOCK_VECTORS=0
# 视频目录文件名（data/ 下）
PUSH_VIDEOS=sample_videos.json
# 覆盖本地 embedding 模型目录（可选）
EMBEDDING_MODEL_PATH=

# ---- 决策配置路径（可选，默认 config/decision_config.json） ----
DECISION_CONFIG_PATH=
PUSH_CONFIG_DIR=

# ---- 业务占位 ----
# 导师引导链接（原真实企业微信链接已移除）
ADVISOR_LINK=https://example.com/advisor

# ---- 自训练（默认关闭） ----
TRAINING_ENABLED=0
TRAINING_SCHEDULE_ENABLED=0
# 外部审查器：none | http | openai-compatible；none 时正例一律不入训
REVIEW_PROVIDER=none
REVIEW_API_URL=
REVIEW_API_KEY=
REVIEW_MODEL=

# ---- 阿里云 VOD 导出（仅运行导出脚本时需要） ----
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_VOD_REGION=cn-shanghai
