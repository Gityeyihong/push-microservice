# === Push Microservice 环境变量 ===
# 复制为 .env 后填写。.env 已被 .gitignore 忽略，切勿提交。

# ---- 服务 ----
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_WORKERS=4
# development：占位密钥只警告，公共令牌可空。
# production：占位 HMAC、空令牌、占位 Redis 密码、或 PUSH_USE_MOCK_VECTORS=1 都会拒绝启动。
PUSH_ENV=development

# ---- 安全 ----
HMAC_SECRET_KEY=change-me-in-production
# 设置后 /api/v1/* 需要 Authorization: Bearer。留空则公共接口开放（production 下不允许空）。
PUSH_API_TOKEN=
PUSH_ADMIN_TOKEN=
PUSH_INTERNAL_TOKEN=
# /api/v1 每分钟限额。0 表示关闭。
PUSH_RATE_LIMIT_PER_MIN=120
# 只有直连对端落在这个名单里时才采信 X-Forwarded-For。逗号分隔；* 表示信任任意对端。直连客户端时留空。
PUSH_TRUSTED_PROXIES=
# /api/v1 请求体上限（字节）。
PUSH_MAX_BODY_BYTES=262144
# 会话状态在 Redis 中的过期秒数。0 表示不过期。
PUSH_SESSION_TTL_SEC=604800

# ---- Redis 缓存（不可用时自动降级；production 必须设置非占位密码） ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# 本地 compose 可用这个占位值。PUSH_ENV=production 时会被拒绝。
REDIS_PASSWORD=dev-only-change-me

# ---- 向量 ----
PUSH_USE_MOCK_VECTORS=0
# 目录文件名（data/ 下）。PUSH_VIDEOS 仍可作为别名。
PUSH_CATALOG=catalog.json
PUSH_VIDEOS=
EMBEDDING_MODEL_PATH=

# ---- 配置路径（可选） ----
POLICY_CONFIG_PATH=
KEYWORDS_CONFIG_PATH=
PUSH_CONFIG_DIR=

# ---- 可插拔组件（可选） ----
# 决策策略：builtin:default 或 module.path:ClassName
POLICY_PROVIDER=builtin:default
# 转人工策略：builtin:default 或 module.path:ClassName
HANDOFF_PROVIDER=builtin:default
# 排序：builtin:default 或 module.path:ClassName（类实现 rank()）
RANKER_PROVIDER=builtin:default
# 导师/转接引导链接（通用占位）
HANDOFF_LINK=https://example.com/handoff

# ---- 自训练（默认关闭） ----
TRAINING_ENABLED=0
# 仅独立进程 `python -m selftrain.scheduler` 读取。线上服务不会启动调度。
# production 下服务进程拒绝 POST /admin/training/run，除非设为 1。
TRAINING_SCHEDULE_ENABLED=0
TRAINING_IN_PROCESS=0
# 存储后端：sqlite（零依赖回退）或 postgres
TRAINING_BACKEND=sqlite
DATABASE_URL=
REDIS_URL=
# 奖励适配器：builtin:generic_funnel 或 module.path:ClassName
# 外部审查器：none | http | openai-compatible（none 时正例一律不入训）
REVIEW_PROVIDER=none
REVIEW_API_URL=
REVIEW_API_KEY=
REVIEW_MODEL=
